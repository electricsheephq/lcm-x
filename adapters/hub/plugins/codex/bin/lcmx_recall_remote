#!/usr/bin/env python3
"""lcmx_recall_remote: the MCP server entry of the lcmx plugins. It becomes an SSH session to the LCM-X hub, whose
forced command for this node's key serves recall over stdio. Settings: ``~/.config/lcmx-hub/node.env`` (see
lcmx_sync). Stdlib only, Python 3.9+."""
import os
from pathlib import Path

import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

loader = importlib.machinery.SourceFileLoader("lcmx_sync", str(Path(__file__).resolve().parent / "lcmx_sync"))
sync = importlib.util.module_from_spec(importlib.util.spec_from_loader("lcmx_sync", loader))
loader.exec_module(sync)
command = sync.ssh_command(sync.settings(), "recall")
os.execvp(command[0], command)
