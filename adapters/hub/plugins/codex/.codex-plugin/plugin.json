{
  "name": "lcmx-hub",
  "version": "0.1.0",
  "description": "Shared LCM-X memory for coding agents: copies this node's sessions to the LCM-X hub, gives the agent the hub's recall tools (all nodes, all sessions), and adds LCM-X context at session start, after a compaction and (opt-in) for each prompt.",
  "author": {
    "name": "LCM-X contributors"
  },
  "license": "MIT",
  "keywords": [
    "memory",
    "recall",
    "lcm-x"
  ],
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'exec python3 -I -S \"$PLUGIN_ROOT/bin/lcmx_context\" --harness codex'",
              "timeout": 10
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'exec python3 -I -S \"$PLUGIN_ROOT/bin/lcmx_context\" --harness codex'",
              "timeout": 8
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'exec python3 -I -S \"$PLUGIN_ROOT/bin/lcmx_sync\" --background'",
              "timeout": 5
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'exec python3 -I -S \"$PLUGIN_ROOT/bin/lcmx_sync\" --background'",
              "timeout": 5
            }
          ]
        }
      ],
      "PreCompact": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh -c 'exec python3 -I -S \"$PLUGIN_ROOT/bin/lcmx_context\" --harness codex'",
              "timeout": 20
            }
          ]
        }
      ]
    }
  },
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "interface": {
    "displayName": "LCM-X hub",
    "shortDescription": "Shared lossless memory across dev agents",
    "developerName": "LCM-X contributors",
    "category": "Developer Tools"
  }
}
