{
  "description": "lcmx-hub: SessionStart and UserPromptSubmit add LCM-X context (lcmx_context); Stop, SubagentStop and SessionEnd copy new transcript bytes to the hub in the background; PreCompact syncs first, then names the session on the hub for the compaction summary.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_context",
              "--harness",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_context",
              "--harness",
              "claude"
            ],
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_sync",
              "--background"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_sync",
              "--background"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_context",
              "--harness",
              "claude"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/bin/lcmx_sync",
              "--background"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
